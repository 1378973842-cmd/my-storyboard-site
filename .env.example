# 将本文件复制为项目根目录的 `.env`（与 package.json 同级），填入真实值后重启 `npm run dev`。
# `.env` 已加入 .gitignore，勿提交到仓库。

# ---------- 邮箱账号登录（替代旧版 ACCESS_CODE 暗号）----------
# 生产环境 NODE_ENV=production 时：SESSION_SECRET 至少 32 位随机字符串，否则服务拒绝启动
SESSION_SECRET="your-random-secret-at-least-32-characters-long"
# 首次启动且 users 表为空时，用以下变量创建管理员（之后请在「用户管理」里为同事建号）
ADMIN_EMAIL="admin@your-studio.com"
ADMIN_PASSWORD="your-strong-password-at-least-8-chars"
# ADMIN_DISPLAY_NAME="管理员"
# 登录 Session 有效期（毫秒，默认 7 天）
# AUTH_SESSION_TTL_MS=604800000
# 登录暴力尝试限流（默认 15 分钟内最多 10 次 / IP）
# AUTH_LOGIN_MAX_ATTEMPTS=10
# AUTH_LOGIN_WINDOW_MS=900000
# 反向代理 HTTPS 时 Cookie 自动加 Secure；本地 HTTP 可设 AUTH_COOKIE_SECURE=0
# AUTH_COOKIE_SECURE="1"
# 置于 Nginx/Caddy 后时建议开启（识别 X-Forwarded-Proto）
# TRUST_PROXY="1"

# ---------- 旧版站点暗号（已废弃，仅 canvas_source 独立服务可能仍使用）----------
# ACCESS_CODE="your-strong-secret-at-least-8-chars"

# ---------- 必填：第三方 OpenAI 兼容网关（生图等非 gemini-3.5-flash 文本仍走此接口）----------
# Base：把官方 api.openai.com 换成平台给的域名即可。
# 可填 https://你的域名 或 https://你的域名/v1（本服务会自动补全 /v1）
# 实际请求：{Base}/v1/chat/completions、{Base}/v1/images/generations
THIRD_PARTY_API_BASE="https://ai.comfly.org"
# 密钥只填 sk-… 即可；代码里会加 Bearer。不要写成 "Bearer sk-…"
THIRD_PARTY_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"

# ---------- gemini-3.5-flash 专用：APIMart Chat Completions（多模态反推 / 画布 Agent / 九宫格 Phase A）----------
# 仅当模型 ID 为 gemini-3.5-flash 时走 https://api.apimart.ai/v1/chat/completions（勿用 /v1/responses，该端点仅支持 GPT 多模态）
APIMART_API_BASE="https://api.apimart.ai"
APIMART_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# 可选：VPN/运营商 DNS 污染 api.apimart.ai 时，代码会用 1.1.1.1/8.8.8.8 解析真实 IP 再连接（默认开启）
# APIMART_DNS_FIX="0"
# APIMART_RESOLVE_IP="104.26.10.94"

# ---------- 必填：模型 ID（须与中转后台、令牌「模型范围」完全一致）----------
# 文本：画布选择 gemini-3.5-flash 时走 APIMART_API_*；其它文本模型仍走 THIRD_PARTY_* / NINE_GRID_TEXT_*
TEXT_MODEL="gemini-3.5-flash"
# 生图：POST /v1/images/generations（主页 Shot 编辑里的「生图」与「编辑」共用 IMAGE_MODEL / IMAGE_EDIT_MODEL）
IMAGE_MODEL="nano-banana-pro-稳定"
# 图片编辑：POST /v1/images/edits（默认旧编辑模型；未设置时会回退尝试 IMAGE_MODEL）
IMAGE_EDIT_MODEL="nano-banana-pro-稳定"
# 编辑接口默认返回格式（旧模型通常用 url）
IMAGE_EDIT_RESPONSE_FORMAT="url"
# 前端新增「GPT编辑」板块会在请求体里覆盖 model=gpt-image-2 与 response_format=b64_json
# 可选：仅 GPT 编辑单独密钥/网关（未设置时回退 THIRD_PARTY_API_KEY / THIRD_PARTY_API_BASE）
# GPT_IMAGE_EDIT_API_BASE="https://ai.comfly.org"
# GPT_IMAGE_EDIT_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"

# ---------- 主线 / 分镜 / 图片编辑页 / 无限画布 API 生成：RunningHub（与 storyboard 共用）----------
# 配置 STORYBOARD_IMAGE_API_KEY 后，/api/edit-image 与 /api/generate-image 优先走 RunningHub；未配置则回退 THIRD_PARTY_*
STORYBOARD_IMAGE_API_BASE="https://www.runninghub.ai"
STORYBOARD_IMAGE_API_KEY="your-runninghub-api-key"
# RunningHub 文本 LLM（glm-5.1 等）：POST https://llm.runninghub.cn/v1/chat/completions
# 画布选择 glm-5.1 时自动走此端点；未设置 RUNNINGHUB_LLM_API_KEY 时回退 STORYBOARD_IMAGE_API_KEY
# RUNNINGHUB_LLM_API_BASE="https://llm.runninghub.cn"
# RUNNINGHUB_LLM_API_KEY="your-runninghub-api-key"
# RUNNINGHUB_LLM_REASONING_EFFORT="none"
# STORYBOARD_IMAGE_EDIT_PATH="/openapi/v2/rhart-image-n-pro/edit"
# STORYBOARD_IMAGE_GPT_PATH="/openapi/v2/rhart-image-g-2/image-to-image"
# 画布九宫格 Agent（gpt-image-2 Phase B / 单格编辑）默认走官方稳定图生图；可覆盖：
# NINE_GRID_GPT_PATH="/openapi/v2/rhart-image-g-2-official/image-to-image"
# STORYBOARD_IMAGE_T2I_PATH="/openapi/v2/rhart-image-n-pro-official/text-to-image"
# STORYBOARD_IMAGE_QUERY_PATH="/openapi/v2/query"
# STORYBOARD_IMAGE_UPLOAD_PATH="/openapi/v2/media/upload/binary"
# STORYBOARD_IMAGE_GPT_QUALITY="medium"
# 九宫格 Phase B 大图：POST /v1/images/edits（模型默认与主页 IMAGE_MODEL 一致时可填 nano-banana-pro-稳定）
# 九宫格「单格编辑」走 /api/edit-image，与分镜相同：使用 THIRD_PARTY_API_* 与 IMAGE_EDIT_MODEL / IMAGE_MODEL
# IMAGE_GRID_API_BASE 缺省时沿用 THIRD_PARTY_API_BASE；IMAGE_GRID_API_KEY 缺省时沿用 THIRD_PARTY_API_KEY
# 若希望九宫格「文本 + 大图」与主页同一把 Key：可不设 NINE_GRID_TEXT_API_KEY / IMAGE_GRID_API_KEY
IMAGE_GRID_API_BASE="https://ai.comfly.org"
IMAGE_GRID_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
IMAGE_GRID_MODEL="nano-banana-pro-稳定"

# 九宫格 Phase A 剧本→9 条 prompt：POST /v1/chat/completions（分镜页 /api/generate-script 等共用此渠道）
# NINE_GRID_TEXT_API_BASE 缺省时沿用 THIRD_PARTY_API_BASE；NINE_GRID_TEXT_API_KEY 缺省时沿用 THIRD_PARTY_API_KEY
# NINE_GRID_TEXT_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# NINE_GRID_TEXT_MODEL 缺省时优先 gemini-3.5-flash；仅当 TEXT_MODEL 非 gemini-3.1-pro-preview 时才回退 TEXT_MODEL
# NINE_GRID_TEXT_MODEL="gemini-3.5-flash"
# Phase A 单格 prompt 不足 150 字时的扩写重试次数（默认 1，即最多请求 LLM 2 次）
# NINE_GRID_TEXT_QUALITY_RETRIES=1

# 分镜页文本 API 与九宫格 Phase A 相同：NINE_GRID_TEXT_API_* → 回退 THIRD_PARTY_*

# RunningHub 等上游返回的图片 URL 回存到 /uploads/ 时的体积上限（默认 50MB，九宫格 4K 大图需足够空间）
# UPSTREAM_IMAGE_PROXY_MAX_BYTES=52428800
# UPSTREAM_IMAGE_PROXY_TIMEOUT_MS=120000

# 可选：参考图传给上游的格式。默认 base64（去掉 data URL 前缀）；若上游要求完整 data: 字符串则填 data_url
# IMAGE_GEN_REFERENCE_MODE="base64"

# ---------- RunningHub 自定义工作流 / AI 应用（画布「RH生成」节点 + 后台管理页）----------
# 未设置时自动回退 STORYBOARD_IMAGE_API_KEY / STORYBOARD_IMAGE_API_BASE，通常不需要单独配置
# RUNNINGHUB_API_KEY="your-runninghub-api-key"
# RUNNINGHUB_API_BASE="https://www.runninghub.ai"
# 可选：账户余额（钱包）模式使用的独立 Key，节点里可切换「免费积分 / 账户余额」
# RUNNINGHUB_WALLET_API_KEY="your-runninghub-wallet-api-key"
# 可选：额外 Key；前端下拉只显示别名（如 key2），密钥正文不下发。格式：别名:key|别名:key
# RUNNINGHUB_API_KEYS="key2:your-key-b"
