# 将本文件复制为项目根目录的 `.env`（与 package.json 同级），填入真实值后重启 `npm run dev`。
# `.env` 已加入 .gitignore，勿提交到仓库。

# ---------- 必填：第三方 OpenAI 兼容网关（本项目文本/生图均走此接口）----------
# Base：把官方 api.openai.com 换成平台给的域名即可。
# 可填 https://你的域名 或 https://你的域名/v1（本服务会自动补全 /v1）
# 实际请求：{Base}/v1/chat/completions、{Base}/v1/images/generations
THIRD_PARTY_API_BASE="https://ai.comfly.chat"
# 密钥只填 sk-… 即可；代码里会加 Bearer。不要写成 "Bearer sk-…"
THIRD_PARTY_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"

# ---------- 必填：模型 ID（须与中转后台、令牌「模型范围」完全一致）----------
# 文本：POST /v1/chat/completions
TEXT_MODEL="gemini-3.1-pro-preview"
# 生图：POST /v1/images/generations（主页 Shot 编辑里的「生图」与「编辑」共用 IMAGE_MODEL / IMAGE_EDIT_MODEL）
IMAGE_MODEL="nano-banana-pro-2k"
# 图片编辑：POST /v1/images/edits（默认旧编辑模型；未设置时会回退尝试 IMAGE_MODEL）
IMAGE_EDIT_MODEL="nano-banana-pro-2k"
# 编辑接口默认返回格式（旧模型通常用 url）
IMAGE_EDIT_RESPONSE_FORMAT="url"
# 前端新增「GPT编辑」板块会在请求体里覆盖 model=gpt-image-2 与 response_format=b64_json
# 可选：仅 GPT 编辑单独密钥/网关（未设置时回退 THIRD_PARTY_API_KEY / THIRD_PARTY_API_BASE）
# GPT_IMAGE_EDIT_API_BASE="https://ai.comfly.chat"
# GPT_IMAGE_EDIT_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# 九宫格 Phase B 大图：POST /v1/images/edits（模型默认与主页 IMAGE_MODEL 一致时可填 nano-banana-pro-2k）
# 九宫格「单格编辑」走 /api/edit-image，与分镜相同：使用 THIRD_PARTY_API_* 与 IMAGE_EDIT_MODEL / IMAGE_MODEL
# IMAGE_GRID_API_BASE 缺省时沿用 THIRD_PARTY_API_BASE；IMAGE_GRID_API_KEY 缺省时沿用 THIRD_PARTY_API_KEY
# 若希望九宫格「文本 + 大图」与主页同一把 Key：可不设 NINE_GRID_TEXT_API_KEY / IMAGE_GRID_API_KEY
IMAGE_GRID_API_BASE="https://ai.comfly.chat"
IMAGE_GRID_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
IMAGE_GRID_MODEL="nano-banana-pro-2k"

# 九宫格 Phase A 剧本→9 条 prompt：POST /v1/chat/completions
# NINE_GRID_TEXT_API_BASE 缺省时沿用 THIRD_PARTY_API_BASE；NINE_GRID_TEXT_API_KEY 缺省时沿用 THIRD_PARTY_API_KEY
# NINE_GRID_TEXT_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# NINE_GRID_TEXT_MODEL 缺省时沿用 TEXT_MODEL
# NINE_GRID_TEXT_MODEL="gemini-3.1-pro-preview"

# 可选：参考图传给上游的格式。默认 base64（去掉 data URL 前缀）；若上游要求完整 data: 字符串则填 data_url
# IMAGE_GEN_REFERENCE_MODE="base64"
